# Frontend Configuration
# Copy this to .env.local and adjust values for your environment
# Vite uses VITE_ prefix for environment variables that are exposed to client

# API Base URL - used for all API calls
VITE_API_BASE=http://localhost:8000

# Environment
VITE_ENVIRONMENT=development

# Google Analytics (optional)
# Only loads in production when VITE_ENVIRONMENT=production
# Leave empty or omit to disable analytics
VITE_GA_TAG=
